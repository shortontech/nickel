<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="Nickel"
           Manufacturer="Nickel contributors"
           Version="$(ProductVersion)"
           UpgradeCode="4F7A7889-AE11-438E-938C-6D1457414292"
           Scope="perUser"
           InstallerVersion="500"
           Compressed="yes">
    <SummaryInformation Description="Nickel desktop shell for Windows" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of Nickel is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Property Id="INSTALLLEVEL" Value="1" />
    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />
    <ui:WixUI Id="WixUI_FeatureTree" />

    <util:CloseApplication Id="CloseNickel"
                           Target="nickel.exe"
                           Description="Nickel must close before setup can continue."
                           CloseMessage="yes"
                           ElevatedCloseMessage="yes"
                           ElevatedEndSessionMessage="yes"
                           Timeout="5"
                           TerminateProcess="0"
                           RebootPrompt="no" />
    <util:CloseApplication Id="CloseNickelSettings"
                           Target="nickel-settings.exe"
                           Description="Nickel Settings must close before setup can continue."
                           CloseMessage="yes"
                           ElevatedCloseMessage="yes"
                           ElevatedEndSessionMessage="yes"
                           Timeout="5"
                           TerminateProcess="0"
                           RebootPrompt="no" />
    <util:CloseApplication Id="CloseNickelTerminal"
                           Target="nickel-terminal.exe"
                           Description="Nickel Terminal must close before setup can continue."
                           CloseMessage="yes"
                           ElevatedCloseMessage="yes"
                           ElevatedEndSessionMessage="yes"
                           Timeout="5"
                           TerminateProcess="0"
                           RebootPrompt="no" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="InstallFolder" Name="Nickel" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuNickel" Name="Nickel" />
    </StandardDirectory>

    <Feature Id="NickelFeature"
             Title="Nickel desktop"
             Description="Install Nickel and its settings and terminal applications."
             Level="1">
      <ComponentGroupRef Id="NickelFiles" />
      <Feature Id="DefaultShellFeature"
               Title="Make Nickel the default shell"
               Description="Start Nickel instead of Explorer when this account next signs in. Removing this feature or uninstalling Nickel restores the normal Windows default."
               Level="2"
               AllowAbsent="yes">
        <ComponentRef Id="ShellSelectionMarker" />
      </Feature>
    </Feature>

    <CustomAction Id="EnableNickelShell"
                  FileRef="NickelShellSetupExe"
                  ExeCommand="enable &quot;[#NickelExe]&quot;"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="check" />
    <CustomAction Id="RollbackEnableNickelShell"
                  FileRef="NickelShellSetupExe"
                  ExeCommand="disable &quot;[#NickelExe]&quot;"
                  Execute="rollback"
                  Impersonate="yes"
                  Return="ignore" />
    <CustomAction Id="DisableNickelShell"
                  FileRef="NickelShellSetupExe"
                  ExeCommand="disable &quot;[#NickelExe]&quot;"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="check" />
    <CustomAction Id="RollbackDisableNickelShell"
                  FileRef="NickelShellSetupExe"
                  ExeCommand="enable &quot;[#NickelExe]&quot;"
                  Execute="rollback"
                  Impersonate="yes"
                  Return="ignore" />
    <CustomAction Id="ActivateNickelShell"
                  FileRef="NickelShellSetupExe"
                  ExeCommand="activate &quot;[#NickelExe]&quot;"
                  Execute="commit"
                  Impersonate="yes"
                  Return="check" />

    <InstallExecuteSequence>
      <Custom Action="RollbackEnableNickelShell"
              Before="EnableNickelShell"
              Condition="(&amp;DefaultShellFeature = 3) AND NOT (!DefaultShellFeature = 3)" />
      <Custom Action="EnableNickelShell"
              After="InstallFiles"
              Condition="(&amp;DefaultShellFeature = 3) AND NOT (!DefaultShellFeature = 3)" />
      <Custom Action="RollbackDisableNickelShell"
              Before="DisableNickelShell"
              Condition="(!DefaultShellFeature = 3) AND (&amp;DefaultShellFeature = 2)" />
      <Custom Action="DisableNickelShell"
              Before="RemoveFiles"
              Condition="(!DefaultShellFeature = 3) AND (&amp;DefaultShellFeature = 2)" />
      <Custom Action="ActivateNickelShell"
              After="EnableNickelShell"
              Condition="(&amp;DefaultShellFeature = 3)" />
    </InstallExecuteSequence>
  </Package>

  <Fragment>
    <ComponentGroup Id="NickelFiles" Directory="InstallFolder">
      <Component Id="NickelExecutable" Guid="81EC88BA-5012-4B48-BEB4-BBA60E8DAB14">
        <File Id="NickelExe" Source="$(PayloadDir)\nickel.exe">
          <Shortcut Id="NickelStartMenuShortcut"
                    Directory="ProgramMenuNickel"
                    Name="Nickel"
                    Description="Start the Nickel desktop"
                    WorkingDirectory="InstallFolder" />
        </File>
        <RegistryValue Root="HKCU" Key="Software\Nickel\Installer\Components"
                       Name="Nickel" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="NickelSettingsExecutable" Guid="E121D8E8-B064-440C-A122-D02D0C638084">
        <File Id="NickelSettingsExe" Source="$(PayloadDir)\nickel-settings.exe">
          <Shortcut Id="NickelSettingsStartMenuShortcut"
                    Directory="ProgramMenuNickel"
                    Name="Nickel Settings"
                    Description="Configure Nickel"
                    WorkingDirectory="InstallFolder" />
        </File>
        <RegistryValue Root="HKCU" Key="Software\Nickel\Installer\Components"
                       Name="Settings" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="NickelTerminalExecutable" Guid="44ABC6CB-01CF-4901-B42F-78BF83165413">
        <File Id="NickelTerminalExe" Source="$(PayloadDir)\nickel-terminal.exe">
          <Shortcut Id="NickelTerminalStartMenuShortcut"
                    Directory="ProgramMenuNickel"
                    Name="Nickel Terminal"
                    Description="Open Nickel Terminal"
                    WorkingDirectory="InstallFolder" />
        </File>
        <RegistryValue Root="HKCU" Key="Software\Nickel\Installer\Components"
                       Name="Terminal" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="NickelShellSetupExecutable" Guid="5E90B55F-B6C2-47FF-9D08-1892014954E4">
        <File Id="NickelShellSetupExe" Source="$(PayloadDir)\nickel-shell-setup.exe" />
        <RegistryValue Root="HKCU" Key="Software\Nickel\Installer\Components"
                       Name="ShellSetup" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="NickelLicenseFiles" Guid="45A8544A-8632-4957-9564-E115A8558D85">
        <File Id="LicenseMit" Source="$(PayloadDir)\LICENSE-MIT" />
        <File Id="LicenseApache" Source="$(PayloadDir)\LICENSE-APACHE" />
        <File Id="CargoLock" Source="$(PayloadDir)\Cargo.lock" />
        <File Id="Notice" Source="$(PayloadDir)\NOTICE.md" />
        <File Id="ThirdPartyLicenses" Source="$(PayloadDir)\THIRD_PARTY_LICENSES.txt" />
        <RemoveFolder Id="RemoveNickelInstallFolder" Directory="InstallFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\Nickel\Installer\Components"
                       Name="Licenses" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="NickelStartMenuFolder" Guid="04B20720-E90F-4335-B474-E9E112CFC533">
        <RemoveFolder Id="RemoveNickelStartMenuFolder" Directory="ProgramMenuNickel" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\Nickel\Installer"
                       Name="StartMenuFolder"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Component Id="ShellSelectionMarker"
               Directory="InstallFolder"
               Guid="7A40460E-50D6-48F5-965D-243D78144481">
      <RegistryValue Root="HKCU"
                     Key="Software\Nickel\Installer"
                     Name="DefaultShell"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
