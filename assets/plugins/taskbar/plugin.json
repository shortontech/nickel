{
  "api_version": 1,
  "id": "org.nickel.taskbar",
  "name": "Nickel Taskbar",
  "entry": "main.js",
  "surfaces": [
    {"id": "main", "kind": "panel", "width": 1920, "height": 56, "output": "all"}
  ],
  "capabilities": [
    "launcher-show",
    "control-center-show",
    "on-screen-keyboard-show",
    "projects-menu-show",
    "windows-read",
    "windows-focus",
    "windows-context",
    "applications-launch",
    "applications-pin",
    "tray-read",
    "tray-activate",
    "tray-context"
  ],
  "provides_slots": [
    {"id":"task-badge","contract":"badge","replaceable":false}
  ]
}
