{
  "api_version": 1,
  "id": "nickel-default",
  "name": "Nickel Default Shell",
  "author": "Nickel",
  "version": "0.2.0",
  "entry": "src/Shell.js",
  "composition": {
    "api_version": 1,
    "id": "nickel-default",
    "version": "0.2.0",
    "exports": {
      "shell": "./src/Shell.js#Shell",
      "shell.taskbar": "./src/Taskbar.js#Taskbar",
      "shell.launcher": "./src/Launcher.js#Launcher",
      "shell.quickSettings": "./src/QuickSettings.js#QuickSettings",
      "shell.notifications": "./src/Notifications.js#Notifications",
      "shell.settings": "./src/Settings.js#Settings",
      "shell.settings.navigation": "./src/Settings.js#SettingsNavigation",
      "shell.settings.controls": "./src/Settings.js#SettingControl",
      "shell.settings.colorPicker": "./src/ColorPicker.js#ColorPicker",
      "shell.settings.appearance": "./src/Appearance.js#Appearance",
      "shell.settings.defaultApps": "./src/DefaultApps.js#DefaultApps",
      "shell.settings.displays": "./src/Displays.js#Displays",
      "shell.settings.wifi": "./src/Wifi.js#Wifi",
      "shell.settings.bluetooth": "./src/Bluetooth.js#Bluetooth",
      "shell.settings.preferences": "./src/Preferences.js#Preferences",
      "shell.settings.idle": "./src/Preferences.js#IdlePreferences",
      "shell.settings.preferredApplications": "./src/Preferences.js#PreferredApplications",
      "shell.settings.fileArtwork": "./src/Preferences.js#FileArtwork",
      "shell.settings.plugins": "./src/Plugins.js#Plugins"
    }
  },
  "capabilities": [
    "appearance-control",
    "appearance-read",
    "applications-launch",
    "applications-pin",
    "applications-read",
    "associations-control",
    "associations-read",
    "audio-control",
    "audio-read",
    "bluetooth-control",
    "bluetooth-read",
    "control-center-show",
    "desktop-control",
    "display-control",
    "launcher-show",
    "network-control",
    "network-read",
    "notifications-act",
    "notifications-read",
    "on-screen-keyboard-show",
    "preferences-control",
    "preferences-read",
    "plugins-control",
    "plugins-read",
    "projects-menu-show",
    "projects-open",
    "projects-read",
    "session-control",
    "session-logout-request",
    "settings-read",
    "settings-show",
    "settings-write",
    "tray-activate",
    "tray-context",
    "tray-read",
    "wallpaper-control",
    "wallpaper-read",
    "windows-context",
    "windows-focus",
    "windows-read",
    "workspaces-read",
    "workspaces-switch"
  ],
  "surfaces": [
    {
      "id": "taskbar",
      "kind": "panel",
      "width": 1920,
      "height": 56,
      "output": "all",
      "reserve_work_area": true
    },
    {
      "id": "settings",
      "kind": "window",
      "width": 1100,
      "height": 800,
      "initially_open": false
    },
    {
      "id": "launcher",
      "kind": "window",
      "width": 620,
      "height": 548,
      "initially_open": false
    },
    {
      "id": "quick-settings",
      "kind": "overlay",
      "width": 420,
      "height": 600,
      "anchor": "top-right",
      "passive": true,
      "initially_open": false
    },
    {
      "id": "notifications",
      "kind": "overlay",
      "width": 420,
      "height": 180,
      "anchor": "top-right",
      "passive": true,
      "initially_open": false
    }
  ]
}
