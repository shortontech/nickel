{
  "api_version": 1,
  "id": "nickel-default",
  "name": "Nickel Default Shell",
  "author": "Nickel",
  "version": "0.2.0",
  "entry": "src/Shell.tsx",
  "images": [
    { "id": "nickel-logo", "path": "images/nickel-logo.png" }
  ],
  "composition": {
    "api_version": 1,
    "id": "nickel-default",
    "version": "0.2.0",
    "exports": {
      "shell": "./src/Shell.tsx#Shell",
      "shell.taskbar": "./src/Taskbar.tsx#Taskbar",
      "shell.launcher": "./src/Launcher.tsx#Launcher",
      "shell.quickSettings": "./src/QuickSettings.tsx#QuickSettings",
      "shell.notifications": "./src/Notifications.tsx#Notifications",
      "shell.settings": "./src/Settings.tsx#Settings",
      "shell.settings.navigation": "./src/Settings.tsx#SettingsNavigation",
      "shell.settings.controls": "./src/Settings.tsx#SettingControl",
      "shell.settings.colorPicker": "./src/ColorPicker.tsx#ColorPicker",
      "shell.settings.appearance": "./src/Appearance.tsx#Appearance",
      "shell.settings.shellSelection": "./src/ThemePicker.tsx#ThemePicker",
      "shell.settings.defaultApps": "./src/DefaultApps.tsx#DefaultApps",
      "shell.settings.displays": "./src/Displays.tsx#Displays",
      "shell.settings.wifi": "./src/Wifi.tsx#Wifi",
      "shell.settings.bluetooth": "./src/Bluetooth.tsx#Bluetooth",
      "shell.settings.preferences": "./src/Preferences.tsx#Preferences",
      "shell.settings.idle": "./src/Preferences.tsx#IdlePreferences",
      "shell.settings.preferredApplications": "./src/Preferences.tsx#PreferredApplications",
      "shell.settings.fileArtwork": "./src/Preferences.tsx#FileArtwork",
      "shell.settings.plugins": "./src/Plugins.tsx#Plugins",
      "shell.settings.optionalFeatures": "./src/OptionalFeatures.tsx#OptionalFeatures",
      "shell.settings.keyboardShortcuts": "./src/KeyboardShortcuts.tsx#KeyboardShortcuts",
      "shell.settings.about": "./src/About.tsx#About",
      "shell.windowMenu": "./src/WindowMenu.tsx#WindowMenu",
      "shell.volumeOSD": "./src/VolumeOSD.tsx#VolumeOSD",
      "shell.window-preview": "./src/Preview.tsx#Preview",
      "shell.run": "./src/Run.tsx#Run",
      "shell.keyboard": "./src/OnScreenKeyboard.tsx#OnScreenKeyboard"
    }
  },
  "capabilities": [
    "appearance-control",
    "appearance-read",
    "applications-launch",
    "applications-pin",
    "applications-read",
    "associations-control",
    "associations-read",
    "audio-control",
    "audio-read",
    "bluetooth-control",
    "bluetooth-read",
    "control-center-show",
    "desktop-control",
    "display-control",
    "features-control",
    "features-read",
    "launcher-show",
    "network-control",
    "network-read",
    "notifications-act",
    "notifications-read",
    "on-screen-keyboard-show",
    "plugins-control",
    "plugins-read",
    "preferences-control",
    "preferences-read",
    "projects-menu-show",
    "session-control",
    "session-logout-request",
    "settings-read",
    "settings-show",
    "settings-write",
    "shortcuts-read",
    "tray-activate",
    "tray-context",
    "tray-read",
    "wallpaper-control",
    "wallpaper-read",
    "windows-context",
    "windows-focus",
    "windows-read",
    "workspaces-read",
    "workspaces-switch",
    "run-command",
    "on-screen-keyboard-read",
    "on-screen-keyboard-input"
  ],
  "surfaces": [
    {
      "id": "taskbar",
      "kind": "panel",
      "width": 1920,
      "height": 56,
      "output": "all",
      "reserve_work_area": true
    },
    {
      "id": "settings",
      "kind": "window",
      "width": 1100,
      "height": 800,
      "initially_open": false
    },
    {
      "id": "launcher",
      "kind": "overlay",
      "width": 608,
      "height": 628,
      "anchor": "bottom-left",
      "offset_x": 8,
      "offset_y": -64,
      "initially_open": false
    },
    {
      "id": "quick-settings",
      "kind": "overlay",
      "width": 420,
      "height": 600,
      "anchor": "top-right",
      "passive": true,
      "initially_open": false
    },
    {
      "id": "notifications",
      "kind": "overlay",
      "width": 420,
      "height": 180,
      "anchor": "top-right",
      "passive": true,
      "initially_open": false
    },
    {
      "id": "window-menu",
      "kind": "window",
      "width": 320,
      "height": 400,
      "anchor": "top-left",
      "initially_open": false
    },
    {
      "id": "volume-osd",
      "kind": "overlay",
      "width": 420,
      "height": 96,
      "anchor": "bottom-center",
      "passive": true,
      "initially_open": false
    },
    {
      "id": "window-preview",
      "kind": "overlay",
      "width": 300,
      "height": 214,
      "initially_open": false
    },
    {
      "id": "run",
      "kind": "window",
      "width": 620,
      "height": 180,
      "initially_open": false
    },
    {
      "id": "keyboard",
      "kind": "overlay",
      "width": 1056,
      "height": 640,
      "anchor": "bottom-left",
      "passive": true,
      "initially_open": false
    }
  ]
}
