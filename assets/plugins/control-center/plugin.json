{
  "api_version": 1,
  "id": "org.nickel.control-center",
  "name": "Nickel Control Center",
  "author": "Nickel",
  "version": "0.1.0",
  "entry": "main.js",
  "stylesheet": "ui.css",
  "surfaces": [{"id":"main","kind":"overlay","width":420,"height":600,"anchor":"bottom-right","offset_x":-18,"offset_y":-72,"passive":true}],
  "capabilities": [
    "network-read", "network-control", "bluetooth-read", "bluetooth-control",
    "audio-read", "audio-control", "workspaces-read", "workspaces-switch",
    "desktop-control", "display-control", "notifications-read", "session-control",
    "control-center-show"
  ],
  "provides_slots": [
    {"id":"control-section","contract":"section","replaceable":true}
  ]
}
